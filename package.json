{
  "name": "eslint-config-escapace",
  "description": "Single-entry ESLint baseline for consistent linting across code, tests, and configuration files. Covers TypeScript, JavaScript, optional Vue support, Vitest defaults, YAML, TOML, and JSON variants.",
  "version": "0.0.0",
  "author": {
    "name": "escapace",
    "email": "opensource@escapace.com"
  },
  "bugs": "https://github.com/escapace/eslint-config-escapace/issues",
  "dependencies": {
    "@stylistic/eslint-plugin": "^5.9.0",
    "@typescript-eslint/utils": "^8.56.1",
    "@vitest/eslint-plugin": "^1.6.9",
    "eslint-config-flat-gitignore": "^2.2.1",
    "eslint-plugin-baseline-js": "^0.6.1",
    "eslint-plugin-de-morgan": "^2.1.1",
    "eslint-plugin-depend": "^1.5.0",
    "eslint-plugin-jsonc": "^3.1.1",
    "eslint-plugin-math": "^0.13.1",
    "eslint-plugin-perfectionist": "^5.6.0",
    "eslint-plugin-regexp": "^3.0.0",
    "eslint-plugin-toml": "^1.3.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "eslint-plugin-unicorn": "^63.0.0",
    "eslint-plugin-vue": "^10.8.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "eslint-plugin-yml": "^3.3.0",
    "jsonc-eslint-parser": "^3.1.0",
    "typescript-eslint": "^8.56.1",
    "vue-eslint-parser": "^10.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "20.4.2",
    "@commitlint/config-conventional": "20.4.2",
    "@escapace/pnpm-pack": "0.8.0",
    "@escapace/syncpack-configuration": "0.1.0",
    "@eslint/js": "9.39.3",
    "@ls-lint/ls-lint": "2.3.1",
    "@types/node": "25.3.2",
    "@vitest/coverage-v8": "4.0.18",
    "es-toolkit": "1.45.0",
    "eslint": "9.39.3",
    "eslint-config-escapace": "link:",
    "eslint-config-prettier": "10.1.8",
    "esroll": "1.1.5",
    "json-schema-to-typescript": "15.0.4",
    "knip": "6.0.4",
    "lefthook": "2.1.2",
    "prettier": "3.8.1",
    "prettier-config-escapace": "1.2.2",
    "syncpack": "14.0.1",
    "trigram-utils": "2.0.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18",
    "zx": "8.8.5"
  },
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=10.29.2"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/node/index.js"
    }
  },
  "files": [
    "lib/node",
    "lib/types"
  ],
  "homepage": "https://github.com/escapace/eslint-config-escapace#readme",
  "license": "MPL-2.0",
  "module": "./lib/node/index.js",
  "peerDependencies": {
    "eslint": ">=9.39.2 <10"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": "escapace/eslint-config-escapace",
  "scripts": {
    "build": "pnpm run codegen && tsx scripts/build.ts",
    "codegen": "tsx scripts/codegen.ts",
    "format": "syncpack format && eslint --no-warn-ignored --fix && prettier --no-error-on-unmatched-pattern -uw .",
    "lint": "ls-lint --config .ls-lint.yaml && knip --no-config-hints && eslint",
    "ls-lint": "ls-lint --config .ls-lint.yaml",
    "pack": "pnpm-pack package --pack-destination lib",
    "prepare": "lefthook install",
    "syncpack": "syncpack fix && syncpack format",
    "test": "vitest --no-watch --coverage",
    "typecheck": "tsc --noEmit",
    "update": "ncu --cooldown 7 -p pnpm -u --peer --dep dev,peer,prod,optional && pnpm run syncpack"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./lib/types/index.d.ts"
}
