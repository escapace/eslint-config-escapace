{
  "name": "eslint-config-escapace",
  "description": "",
  "version": "0.0.0",
  "author": {
    "name": "escapace",
    "email": "opensource@escapace.com"
  },
  "bugs": "https://github.com/escapace/eslint-config-escapace/issues",
  "dependencies": {
    "@stylistic/eslint-plugin": "^5.5.0",
    "@typescript-eslint/utils": "^8.46.2",
    "eslint-config-flat-gitignore": "^2.1.0",
    "eslint-plugin-de-morgan": "^2.0.0",
    "eslint-plugin-depend": "^1.3.1",
    "eslint-plugin-jsonc": "^2.21.0",
    "eslint-plugin-perfectionist": "^4.15.1",
    "eslint-plugin-regexp": "^2.10.0",
    "eslint-plugin-toml": "^0.12.0",
    "eslint-plugin-tsdoc": "^0.4.0",
    "eslint-plugin-unicorn": "^62.0.0",
    "eslint-plugin-vue": "^10.5.1",
    "eslint-plugin-vuejs-accessibility": "^2.4.1",
    "eslint-plugin-yml": "^1.19.0",
    "jsonc-eslint-parser": "^2.4.1",
    "toml-eslint-parser": "^0.10.0",
    "typescript-eslint": "^8.46.2",
    "vue-eslint-parser": "^10.2.0",
    "yaml-eslint-parser": "^1.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "@escapace/pnpm-pack": "0.6.0",
    "@eslint/js": "9.36.0",
    "@ls-lint/ls-lint": "2.3.1",
    "@types/lodash-es": "4.17.12",
    "@types/node": "24.5.2",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.36.0",
    "eslint-config-escapace": "link:",
    "eslint-config-prettier": "10.1.8",
    "esroll": "1.1.0",
    "jsdom": "27.0.0",
    "json-schema-to-typescript": "15.0.4",
    "knip": "5.64.1",
    "lefthook": "1.13.4",
    "lodash-es": "4.17.21",
    "prettier": "3.6.2",
    "prettier-config-escapace": "1.2.1",
    "syncpack": "13.0.4",
    "trigram-utils": "2.0.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "zx": "8.8.5"
  },
  "engines": {
    "node": ">=24.9.0",
    "pnpm": ">=10.17.1"
  },
  "exports": {
    ".": {
      "node": {
        "import": {
          "types": "./lib/types/index.d.ts",
          "default": "./lib/node/index.js"
        }
      },
      "browser": {
        "import": {
          "types": "./lib/types/index.d.ts",
          "default": "./lib/browser/index.js"
        }
      },
      "default": {
        "import": {
          "types": "./lib/types/index.d.ts",
          "default": "./lib/node/index.js"
        }
      }
    }
  },
  "files": [
    "lib/browser",
    "lib/node",
    "lib/types"
  ],
  "homepage": "https://github.com/escapace/eslint-config-escapace#readme",
  "license": "MPL-2.0",
  "peerDependencies": {
    "eslint": "^9.36.0"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": "escapace/eslint-config-escapace",
  "scripts": {
    "build": "pnpm run codegen && tsx scripts/build.ts",
    "codegen": "tsx scripts/codegen.ts",
    "format": "syncpack format && eslint --no-warn-ignored --fix && prettier -uw .",
    "lint": "ls-lint --config .ls-lint.yaml && knip --no-config-hints && eslint",
    "ls-lint": "ls-lint --config .ls-lint.yaml",
    "pack": "pnpm-pack package --pack-destination lib",
    "prepare": "lefthook install",
    "syncpack": "syncpack fix-mismatches && syncpack set-semver-ranges && syncpack format",
    "test": "vitest --no-watch --coverage",
    "typecheck": "tsc --noEmit",
    "update": "ncu --cooldown 7 -p pnpm -u --peer --dep dev,peer,prod,optional && pnpm run syncpack"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./lib/types/index.d.ts"
}
