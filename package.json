{
  "name": "eslint-config-escapace",
  "description": "",
  "version": "0.0.0",
  "author": {
    "name": "escapace",
    "email": "opensource@escapace.com"
  },
  "bugs": "https://github.com/escapace/eslint-config-escapace/issues",
  "dependencies": {
    "@stylistic/eslint-plugin": "^4.0.1",
    "@typescript-eslint/utils": "^8.24.1",
    "eslint-config-flat-gitignore": "^2.1.0",
    "eslint-plugin-jsonc": "^2.19.1",
    "eslint-plugin-perfectionist": "^4.9.0",
    "eslint-plugin-regexp": "^2.7.0",
    "eslint-plugin-toml": "^0.12.0",
    "eslint-plugin-tsdoc": "^0.4.0",
    "eslint-plugin-unicorn": "^57.0.0",
    "eslint-plugin-vue": "^9.32.0",
    "eslint-plugin-vuejs-accessibility": "^2.4.1",
    "eslint-plugin-yml": "^1.17.0",
    "jsonc-eslint-parser": "^2.4.0",
    "toml-eslint-parser": "^0.10.0",
    "typescript-eslint": "^8.24.1",
    "vue-eslint-parser": "^9.4.3",
    "yaml-eslint-parser": "^1.2.3"
  },
  "devDependencies": {
    "@commitlint/cli": "19.7.1",
    "@commitlint/config-conventional": "19.7.1",
    "@escapace/pnpm-pack": "0.6.0",
    "@ls-lint/ls-lint": "2.2.3",
    "@types/eslint__js": "8.42.3",
    "@types/eslint-config-prettier": "6.11.3",
    "@types/lodash-es": "4.17.12",
    "@types/node": "22.13.4",
    "@vitest/coverage-v8": "3.0.6",
    "eslint": "9.20.1",
    "eslint-config-escapace": "link:",
    "eslint-config-prettier": "10.0.1",
    "esroll": "0.4.1",
    "json-schema-to-typescript": "15.0.4",
    "knip": "5.44.4",
    "lefthook": "1.10.10",
    "lodash-es": "4.17.21",
    "prettier": "3.5.1",
    "prettier-config-escapace": "1.2.1",
    "syncpack": "13.0.2",
    "trigram-utils": "2.0.1",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "vitest": "3.0.6",
    "zx": "8.3.2"
  },
  "engines": {
    "node": ">=22.13.1",
    "pnpm": ">=10.4.1"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/node/index.js"
    }
  },
  "files": [
    "lib/node",
    "lib/types"
  ],
  "homepage": "https://github.com/escapace/eslint-config-escapace#readme",
  "license": "MPL-2.0",
  "module": "./lib/node/index.js",
  "peerDependencies": {
    "eslint": ">=9.20.1"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": "escapace/eslint-config-escapace",
  "scripts": {
    "build": "pnpm run codegen && tsx scripts/build.ts",
    "codegen": "tsx scripts/codegen.ts",
    "format": "syncpack format && eslint --no-warn-ignored --fix && prettier -uw .",
    "lint": "ls-lint --config .ls-lint.yaml && knip --no-config-hints && eslint",
    "ls-lint": "ls-lint --config .ls-lint.yaml",
    "pack": "pnpm-pack package --pack-destination lib",
    "prepare": "lefthook install",
    "syncpack": "syncpack fix-mismatches && syncpack set-semver-ranges && syncpack format",
    "test": "vitest --no-watch --coverage",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./lib/types/index.d.ts"
}
