{
  "name": "eslint-config-escapace",
  "description": "",
  "version": "0.0.0",
  "author": {
    "name": "escapace",
    "email": "opensource@escapace.com"
  },
  "bugs": "https://github.com/escapace/eslint-config-escapace/issues",
  "dependencies": {
    "@stylistic/eslint-plugin": "^5.1.0",
    "@typescript-eslint/utils": "^8.36.0",
    "eslint-config-flat-gitignore": "^2.1.0",
    "eslint-plugin-de-morgan": "^1.3.0",
    "eslint-plugin-depend": "^1.2.0",
    "eslint-plugin-jsonc": "^2.20.1",
    "eslint-plugin-perfectionist": "^4.15.0",
    "eslint-plugin-regexp": "^2.9.0",
    "eslint-plugin-toml": "^0.12.0",
    "eslint-plugin-tsdoc": "^0.4.0",
    "eslint-plugin-unicorn": "^59.0.1",
    "eslint-plugin-vue": "^10.3.0",
    "eslint-plugin-vuejs-accessibility": "^2.4.1",
    "eslint-plugin-yml": "^1.18.0",
    "jsonc-eslint-parser": "^2.4.0",
    "toml-eslint-parser": "^0.10.0",
    "typescript-eslint": "^8.36.0",
    "vue-eslint-parser": "^10.2.0",
    "yaml-eslint-parser": "^1.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@escapace/pnpm-pack": "0.6.0",
    "@eslint/js": "9.31.0",
    "@ls-lint/ls-lint": "2.3.1",
    "@types/lodash-es": "4.17.12",
    "@types/node": "24.0.13",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.31.0",
    "eslint-config-escapace": "link:",
    "eslint-config-prettier": "10.1.5",
    "esroll": "0.4.5",
    "json-schema-to-typescript": "15.0.4",
    "knip": "5.61.3",
    "lefthook": "1.12.2",
    "lodash-es": "4.17.21",
    "prettier": "3.6.2",
    "prettier-config-escapace": "1.2.1",
    "syncpack": "13.0.4",
    "trigram-utils": "2.0.1",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.4",
    "zx": "8.7.0"
  },
  "engines": {
    "node": ">=22.15.0",
    "pnpm": ">=10.10.0"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/node/index.js"
    }
  },
  "files": [
    "lib/node",
    "lib/types"
  ],
  "homepage": "https://github.com/escapace/eslint-config-escapace#readme",
  "license": "MPL-2.0",
  "module": "./lib/node/index.js",
  "peerDependencies": {
    "eslint": ">=9.31.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ]
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": "escapace/eslint-config-escapace",
  "scripts": {
    "build": "pnpm run codegen && tsx scripts/build.ts",
    "codegen": "tsx scripts/codegen.ts",
    "format": "syncpack format && eslint --no-warn-ignored --fix && prettier -uw .",
    "lint": "ls-lint --config .ls-lint.yaml && knip --no-config-hints && eslint",
    "ls-lint": "ls-lint --config .ls-lint.yaml",
    "pack": "pnpm-pack package --pack-destination lib",
    "prepare": "lefthook install",
    "syncpack": "syncpack fix-mismatches && syncpack set-semver-ranges && syncpack format",
    "test": "vitest --no-watch --coverage",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./lib/types/index.d.ts"
}
