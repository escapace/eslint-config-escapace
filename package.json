{
  "name": "eslint-config-escapace",
  "description": "Single-entry ESLint baseline for consistent linting across code, tests, and configuration files. Covers TypeScript, JavaScript, optional Vue support, Vitest defaults, YAML, TOML, and JSON variants.",
  "version": "0.0.0",
  "author": {
    "name": "escapace",
    "email": "opensource@escapace.com"
  },
  "bugs": "https://github.com/escapace/eslint-config-escapace/issues",
  "dependencies": {
    "@microsoft/tsdoc": "^0.16.0",
    "@microsoft/tsdoc-config": "^0.18.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/utils": "^8.67.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint-plugin-baseline-js": "^0.7.0",
    "eslint-plugin-de-morgan": "^2.1.3",
    "eslint-plugin-depend": "^1.5.0",
    "eslint-plugin-jsonc": "^3.4.1",
    "eslint-plugin-math": "^0.13.1",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-regexp": "^3.1.1",
    "eslint-plugin-toml": "^1.5.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "eslint-plugin-yml": "^3.8.1",
    "jsonc-eslint-parser": "^3.3.0",
    "typescript-eslint": "^8.67.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@escapace/pnpm-pack": "0.9.2",
    "@escapace/syncpack-configuration": "0.3.0",
    "@eslint/js": "10.0.1",
    "@ls-lint/ls-lint": "2.3.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "effect": "4.0.0-beta.107",
    "es-toolkit": "1.50.0",
    "eslint": "10.8.1",
    "eslint-config-escapace": "link:",
    "eslint-config-prettier": "10.1.8",
    "esroll": "1.3.0",
    "json-schema-to-typescript": "15.0.4",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "prettier": "3.9.6",
    "prettier-config-escapace": "1.2.2",
    "syncpack": "15.3.3",
    "trigram-utils": "2.0.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "zx": "8.8.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "warn",
      "version": "^11.5.0"
    },
    "runtime": {
      "name": "node",
      "onFail": "warn",
      "version": "^24.15.0"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/node/index.js"
    }
  },
  "files": [
    "lib/node",
    "lib/types"
  ],
  "homepage": "https://github.com/escapace/eslint-config-escapace#readme",
  "license": "MPL-2.0",
  "module": "./lib/node/index.js",
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": "escapace/eslint-config-escapace",
  "scripts": {
    "build": "pnpm run codegen && tsx scripts/build.ts",
    "codegen": "tsx scripts/codegen.ts",
    "format": "syncpack format && eslint --no-warn-ignored --fix && prettier --no-error-on-unmatched-pattern -uw .",
    "lint": "ls-lint --config .ls-lint.yaml && knip --no-config-hints && eslint",
    "ls-lint": "ls-lint --config .ls-lint.yaml",
    "pack": "pnpm-pack package --pack-destination lib",
    "prepare": "lefthook install",
    "stats:rules": "tsx scripts/rule-performance.ts",
    "syncpack": "syncpack fix && syncpack format",
    "test": "vitest --no-watch --coverage",
    "typecheck": "tsc --noEmit",
    "update": "ncu --cooldown 7 -p pnpm -u --peer --dep dev,peer,prod,optional && pnpm run syncpack"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./lib/types/index.d.ts"
}
